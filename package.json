{
  "name": "rokumon-pool",
  "private": true,
  "version": "0.10.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && node scripts/test-rules.mjs && node scripts/test-ai.mjs && node scripts/test-labels.mjs && node scripts/test-hub.mjs",
    "verify": "npm run build && npm test",
    "smoke": "node scripts/hub-smoke.mjs",
    "smoke:input": "node scripts/browser-smoke.mjs",
    "smoke:input:evidence": "node scripts/browser-smoke.mjs --evidence",
    "smoke:input:record": "node scripts/browser-smoke.mjs --record",
    "banners": "node scripts/make-banners.mjs",
    "verify:full": "npm run verify && npm run smoke && npm run smoke:input"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
